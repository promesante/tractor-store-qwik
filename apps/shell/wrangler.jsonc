{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tractor-shell",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  // The public URL of the store, on workers.dev.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // Unknown paths get public/404.html with a 404 status.
    "not_found_handling": "404-page",
    // The worker decides first: fragment routes, then the shell, then assets.
    "run_worker_first": true,
  },
  "services": [
    { "binding": "EXPLORE", "service": "tractor-explore" },
    { "binding": "DECIDE", "service": "tractor-decide" },
    { "binding": "CHECKOUT", "service": "tractor-checkout" },
  ],
  "vars": { "MODE": "production" },
}
