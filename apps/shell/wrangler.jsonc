{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tractor-shell",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // The worker decides first: fragment routes, then the shell, then assets.
    "run_worker_first": true,
  },
  "services": [
    { "binding": "EXPLORE", "service": "tractor-explore" },
    { "binding": "CHECKOUT", "service": "tractor-checkout" },
  ],
  "vars": { "MODE": "production" },
}
