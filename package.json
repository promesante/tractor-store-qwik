{
  "name": "tractor-store-qwik",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint && pnpm lint:root",
    "lint:root": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "start": "turbo run build && turbo run start",
    "test:e2e": "pnpm --filter @tractor/e2e test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
